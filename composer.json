{
    "name": "code-sphere/livewire-calendar",
    "description": "Livewire monthly calendar component for Laravel. Maintained fork of omnia-digital/livewire-calendar.",
    "keywords": [
        "laravel",
        "livewire",
        "calendar",
        "livewire-calendar",
        "codesphere"
    ],
    "homepage": "https://github.com/Code-Sphere-Development/livewire-calendar",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Collin Ilgner",
            "email": "cilgner@code-sphere.de",
            "role": "Maintainer"
        },
        {
            "name": "Josh Torres",
            "email": "josht@omniadigital.io",
            "role": "Original author"
        },
        {
            "name": "Andrés Santibáñez",
            "email": "santibanez.andres@gmail.com",
            "role": "Original author"
        },
        {
            "name": "Osei Quashie",
            "email": "osei@omniadigital.io",
            "role": "Original author"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "CodeSphere\\LivewireCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeSphere\\LivewireCalendar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "ci": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeSphere\\LivewireCalendar\\LivewireCalendarServiceProvider"
            ],
            "aliases": {
                "LivewireCalendar": "CodeSphere\\LivewireCalendar\\LivewireCalendarFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
